# Copia questo file in ".env" e compila i valori reali
# NON committare mai il file ".env" reale (contiene segreti)

# Stringa di connessione MongoDB
# Locale:    mongodb://localhost:27017/esaarco-auth
# Atlas:     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/esaarco-auth
MONGO_URI=mongodb://localhost:27017/esaarco-auth

# Chiave segreta per firmare i token JWT — cambiala con una stringa lunga e casuale
JWT_SECRET=cambia_questa_chiave_segreta_lunga_e_casuale

# Porta su cui gira il server
PORT=3001
